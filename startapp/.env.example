DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
PUBLIC_SITE_URL=
CHAT_MEDIA_ROOT=
# Click merchant settings. Register /payments/click/callback/ as the merchant callback URL.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_BASE_URL=https://my.click.uz/services/pay

# Payme Business merchant settings. Register /payments/payme/callback/ as the Merchant API URL.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_BASE_URL=https://checkout.paycom.uz

# OpenAI-powered rental search, support and price calculations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploaded listing photos are stored under MEDIA_ROOT (default: startapp/media).

# Telegram registration OTP bot. Configure the public webhook as documented in README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
