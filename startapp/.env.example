DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
PUBLIC_SITE_URL=
CHAT_MEDIA_ROOT=
# Optional storage paths (Docker sets these to /data/...).
SQLITE_PATH=
MEDIA_ROOT=
STATIC_ROOT=
# Serve uploaded photos from Django when DEBUG=0 and there is no nginx in front.
SERVE_MEDIA=0
# Set to 1 when an HTTPS reverse proxy (nginx, Caddy) sits in front of the app.
DJANGO_BEHIND_HTTPS_PROXY=0
# Docker Compose host port.
RENTORA_PORT=8090
# Click merchant settings. Register /payments/click/callback/ as the merchant callback URL.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_BASE_URL=https://my.click.uz/services/pay

# Payme Business merchant settings. Register /payments/payme/callback/ as the Merchant API URL.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_BASE_URL=https://checkout.paycom.uz

# Google Gemini powers rental search, support chat, admin assistant and listing translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Used in order when the main model is overloaded or out of its free daily quota.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-flash-latest

# Uploaded listing photos are stored under MEDIA_ROOT (default: startapp/media).

# Telegram bot. Use a public HTTPS webhook (set_telegram_webhook) or run_telegram_bot long polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Support chat AI: answers in the admin chat when no admin replied within this many seconds.
SUPPORT_AI_ENABLED=1
SUPPORT_AI_DELAY_SECONDS=120
# Django admin path (superusers only). Use a long random path in production, e.g. boshqaruv-7f3k9q2x/.
ADMIN_URL=admin/
# Shared cache folder for rate limits (Docker uses /data/cache).
CACHE_DIR=
# Set to 1 only behind our own reverse proxy (Caddy) that sets X-Real-IP.
TRUST_X_REAL_IP=0
